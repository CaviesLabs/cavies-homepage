# Cloudflare Workers static assets headers (https://developers.cloudflare.com/workers/static-assets/headers/).
# These replace the headers studio/vercel.json set on every response, plus the
# Strict-Transport-Security header Vercel added itself.
/*
  Strict-Transport-Security: max-age=63072000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# The playable-ad demos are embedded by our own /playable-ads page, so they may
# be framed by the same origin (the /* rule above says DENY; a second value would
# be joined to it and ignored, so it is detached first). The page puts them in a
# sandbox without allow-same-origin.
/playable-ads/demos/*
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: noindex
  Content-Security-Policy: sandbox allow-scripts; default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; media-src data: blob:; connect-src 'none'

# Hashed build output never changes.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Resized images and media keep their names when replaced: a day, then revalidate.
/_img/*
  Cache-Control: public, max-age=86400, must-revalidate
/work/*.webp
  Cache-Control: public, max-age=86400, must-revalidate
/work/*.png
  Cache-Control: public, max-age=86400, must-revalidate
/work/*.jpg
  Cache-Control: public, max-age=86400, must-revalidate
/brand/*
  Cache-Control: public, max-age=86400, must-revalidate
/games/oddly-orderly/*.webp
  Cache-Control: public, max-age=86400, must-revalidate
/games/oddly-orderly/*.mp4
  Cache-Control: public, max-age=86400, must-revalidate
