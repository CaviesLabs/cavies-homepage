{
  "name": "cavies-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-cf.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "lint": "eslint .",
    "test:enquiry": "node --experimental-strip-types --test tests/enquiry.test.mjs tests/enquiry-delivery.test.mjs tests/enquiry-rate-limit.test.mjs",
    "test:scope": "node --experimental-strip-types --test tests/project-scope.test.mjs",
    "test:smoke": "node --test tests/site-smoke.test.mjs",
    "build:cf": "node scripts/build-cf.mjs",
    "deploy:cf": "node scripts/deploy-cf.mjs test",
    "test:workerd": "node --test tests/workerd.test.mjs",
    "deploy:cf:production": "node scripts/deploy-cf.mjs production",
    "deploy:cf:redirect": "wrangler deploy -c redirect/wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.162.0"
  }
}
