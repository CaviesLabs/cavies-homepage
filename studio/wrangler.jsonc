{
  // cavies.studio on the Cloudflare Workers Free plan: the static export in out/
  // as Worker static assets, plus the enquiry endpoint at /api/enquiry.
  // This is the workers.dev TEST Worker (`npm run deploy:cf`): its own name, ledger and
  // address, no delivery secrets. Production is the Worker `cavies-studio`, configured in
  // wrangler.production.jsonc. See docs/cloudflare-workers.md.
  "name": "cavies-studio-test",
  "account_id": "22695a77ae05b80e3b67824b68152f29",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["cache_option_enabled"],
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    // Pages and pictures never invoke Worker code; the enquiry endpoint does, and so do the
    // video files, because static assets ignore a Range request (Safari needs ranges to
    // play a video). worker/video-range.ts answers those from the ASSETS binding.
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/*.mp4", "/*.m4v", "/*.mov", "/*.webm"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [{ "name": "LEDGER", "class_name": "EnquiryLedger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EnquiryLedger"] }],
  // Cloudflare Email Sending (free to verified destination addresses on Workers
  // Free). Held to one sender and one recipient, so a code change cannot send
  // anywhere else. The domain is onboarded and tin@ verified (25 Nov 2026).
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["contact@cavies.studio"],
      "allowed_destination_addresses": ["tin@cavies.studio"]
    }
  ],
  // Secrets (wrangler secret put): ENQUIRY_DELIVERY_ENABLED, TURNSTILE_SECRET_KEY,
  // RATE_LIMIT_SALT.
  "workers_dev": true,
  "preview_urls": false
}
